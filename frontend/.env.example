# Copy to .env.local for local overrides. Only VITE_* vars reach the client bundle.
# Backend API origin (prod builds default to same-origin /api if unset).
# VITE_API_BASE=https://your-backend.vercel.app

# Show the "🔍 View AI Prompt & Raw Response" debug sections (default: hidden).
VITE_SHOW_AI_DEBUG=true

# Feedback form URL; shows the footer "leave your valuable feedback" link when set.
# VITE_FEEDBACK_URL=https://docs.google.com/forms/d/e/.../viewform
